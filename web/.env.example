# Build-time configuration for the WizardFlow web app.
# Copy to `.env.local` for local dev, or set these in your host (e.g. Vercel).
# All NEXT_PUBLIC_* values are inlined into the static build — none are secret.

# Deployment target. "hosted" (the default) renders the Impressum/Datenschutz
# pages; "local" hides them (used for the SDK-bundled UI build).
NEXT_PUBLIC_WIZARDFLOW_TARGET=hosted

# Canonical site URL — used for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://getwizardflow.com

# Impressum / Datenschutz provider contact. German law requires real details on
# the live site, so set these in the hosted deployment's env. Leave blank in
# public checkouts — the source falls back to non-personal placeholders.
NEXT_PUBLIC_LEGAL_NAME=Leon Koch
NEXT_PUBLIC_LEGAL_STREET=
NEXT_PUBLIC_LEGAL_CITY=
NEXT_PUBLIC_LEGAL_COUNTRY=Deutschland
NEXT_PUBLIC_LEGAL_EMAIL=
